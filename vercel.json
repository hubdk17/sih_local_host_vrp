{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "web",
  "rewrites": [
    { "source": "/api/cities", "destination": "/api/cities.json" },
    { "source": "/api/proximity-certificate", "destination": "/api/proximity-certificate.json" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
